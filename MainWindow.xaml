<Window x:Class="Capital.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Capital"
        mc:Ignorable="d"
        
        Background="#222831"
        Title="MainWindow" Height="800" Width="1200">


        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" MinWidth ="50" MaxWidth="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="*" MinHeight="350"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Депозит" Foreground="White"/>
            <TextBlock Text="Начальный лот" Grid.Row="1" Foreground="White"/>
            <TextBlock Text="Тейк" Grid.Row="2" Foreground="White"/>
            <TextBlock Text="Стоп" Grid.Row="3" Foreground="White"/>
            <TextBlock Text="Комиссия" Grid.Row="4" Foreground="White"/>
            <TextBlock Text="% Процент приб." Grid.Row="5" Foreground="White"/>
            <TextBlock Text="Кол-во сделок" Grid.Row="6" Foreground="White"/>
            <TextBlock Text="Мин. % депо" Grid.Row="7" Foreground="White"/>
            <TextBlock Text="" Grid.Row="8" Foreground="White"/>
            <TextBlock Text="Гаран. обесп." Grid.Row="9" Foreground="White"/>

            <!--<ComboBox Name="_comboBox" 
                  SelectionChanged="_comboBox_SelectionChanged"
                  Grid.Row="11" 
                  Margin="5,0"
                  Background="#393E46"
                  Foreground="Black"
                  BorderBrush="#00ADB5"
                  FontSize="14"
                  FontWeight="Bold"/>-->






            <!-- Popup, который раскрывается поверх других элементов -->

            <ToggleButton x:Name="ExpanderToggle"
                  Content="STRATEGIES"
                  Grid.Row="11"
                  Margin="5,0"
                  Background="#393E46"
                  Foreground="DarkSeaGreen"
                  FontSize="14"
                  FontWeight="Bold"
                  BorderBrush="#00ADB5"
                  BorderThickness="2"/>


            <Popup PlacementTarget="{Binding ElementName=ExpanderToggle}"
           
               
           IsOpen="{Binding IsChecked, ElementName=ExpanderToggle, Mode=TwoWay}"
           StaysOpen="False"
           AllowsTransparency="True">
                <Border Background="#393E46"
                BorderBrush="#00ADB5"
                BorderThickness="2"
                Width="250">
                    <ListBox SelectionMode="Multiple"
                         Name="_listBox"
                     Background="#393E46"
                     Foreground="White"
                     BorderBrush="#00ADB5"
                     FontSize="16"
                     Width="250">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="#393E46"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#00ADB5"/>
                                        <!-- Яркий фон при выборе -->
                                        <Setter Property="Foreground" Value="DarkBlue"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>

                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Name="_checkBox"  Content="{Binding}"
                              IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Mode=TwoWay}"
                              Foreground="White"
                              Click="CheckBox_Click"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Border>
            </Popup>






            <TextBox x:Name="_depo" Grid.Column="1" />
            <TextBox x:Name="_startLot" Grid.Column="1"         Grid.Row="1"/>
            <TextBox x:Name="_take" Grid.Column="1"             Grid.Row="2"/>
            <TextBox x:Name="_stop" Grid.Column="1"             Grid.Row="3"/>
            <TextBox x:Name="_comiss" Grid.Column="1"           Grid.Row="4"/>
            <TextBox x:Name="_percentProfit" Grid.Column="1"    Grid.Row="5"/>
            <TextBox x:Name="_countTrades" Grid.Column="1"      Grid.Row="6"/>
            <TextBox x:Name="_minStartPercent" Grid.Column="1" Grid.Row="7"/>
            <TextBox x:Name="_go" Grid.Column="1"               Grid.Row="9"/>
            <!--<TextBox x:Name="" Grid.Column="9"/>
        <TextBox x:Name="" Grid.Column="10"/>-->

            <Button Content="Рассчитать"
                Click="Button_Click"
                Grid.Column="1"
                Grid.Row="11"
                Background="#393E46"
                Foreground="White"
                BorderBrush="#00ADB5"
                BorderThickness="2"
                FontSize="18"
                FontWeight="Bold"/>



            <GroupBox Header="Таблица результатов" 
                  Grid.Column="2" Grid.RowSpan="12" 
                  Margin="10,1">
                <DataGrid x:Name="_dataGrid" Margin="5"/>


            </GroupBox>



            <StackPanel Orientation="Horizontal" Grid.Row="13" Grid.ColumnSpan="3" Margin="10" >
                <Label Content ="FIX - Yellow" FontSize="14" Foreground="Yellow"  Padding="10,5" Margin="5"/>
                <Label Content = "CAPITALISATION - Red"  FontSize="14" Foreground="DarkRed"  Padding="10,5" Margin="5" />
                <Label Content ="PROGRESS - Blue" FontSize="14" Foreground="Blue"  Padding="10,5" Margin="5"  />
                <Label Content ="DOWNGRADE - Coral" FontSize="14" Foreground="Coral"  Padding="10,5" Margin="5" />
            </StackPanel>


            <Canvas x:Name="_canvas"
                SizeChanged="Canvas_SizeChanged"
                Grid.Row="14" 
                Grid.ColumnSpan="3" 
                Margin="10" 
                Background="#393E46"/>
            <!--Background="LightGray"-->


        </Grid>
    </Window>

    