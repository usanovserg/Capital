<Window x:Class="Capital.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Capital"
        mc:Ignorable="d"
        Title="Capital (урок 1-9)" Height="800" Width="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*" 
                              MinWidth="50" 
                              MaxWidth="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*" MinHeight="350"/>
        </Grid.RowDefinitions>

        <TextBlock  Text="Депозит"              Grid.Row="0"/>
        <TextBlock  Text="Начальный лот"        Grid.Row="1"/>
        <TextBlock  Text="Тейк"                 Grid.Row="2"/>
        <TextBlock  Text="Стоп"                 Grid.Row="3"/>
        <TextBlock  Text="Комиссия"             Grid.Row="4"/>
        <TextBlock  Text="% Проц.приб.сделок"   Grid.Row="5"/>
        <TextBlock  Text="Кол-во сделок"        Grid.Row="6"/>
        <TextBlock  Text="Мин. % депо"          Grid.Row="7"/>
        <TextBlock  Text="Гарант. обеспечение"  Grid.Row="9"/>
        <ComboBox   x:Name="_comboBox"
                    SelectionChanged="_comboBox_SelectionChanged"
                    Margin="5, 0"
                    Grid.Row="11"/>


        <TextBox    x:Name="_depo"              Grid.Column="1"     Grid.Row="0"/>
        <TextBox    x:Name="_startLot"          Grid.Column="1"     Grid.Row="1"/>
        <TextBox    x:Name="_take"              Grid.Column="1"     Grid.Row="2"/>
        <TextBox    x:Name="_stop"              Grid.Column="1"     Grid.Row="3"/>
        <TextBox    x:Name="_commis"            Grid.Column="1"     Grid.Row="4"/>
        <TextBox    x:Name="_percentProfit"     Grid.Column="1"     Grid.Row="5"/>
        <TextBox    x:Name="_countTrades"       Grid.Column="1"     Grid.Row="6"/>
        <TextBox    x:Name="_minStartPersent"   Grid.Column="1"     Grid.Row="7"/>
        <TextBox    x:Name="_go"                Grid.Column="1"     Grid.Row="9"/>
        <Button     Content="Рассчитать"        Grid.Column="1"     Grid.Row="11"
                    Click="Button_Click"/>                    

        <GroupBox Header="Таблица результатов"
                  Grid.Column="2"
                  Grid.RowSpan="12"
                  Margin="10, 1">
            <DataGrid   x:Name="_dataGrid"  
                        AutoGenerateColumns="False"
                        Margin="5">
                <DataGrid.Columns>                    
                    <DataGridTemplateColumn Header="Стратегия">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StrategyType}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Нач. депо">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Depo, StringFormat=F2}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Результат">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ResultDepo, StringFormat=F2}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Абс. профит">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Profit, StringFormat=F2}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Отн. профит">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PercentProfit, StringFormat=F2}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTemplateColumn Header="Абс. макс. просадка">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MaxDrawDown, StringFormat=F2}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTemplateColumn Header="Отн. макс. просадка">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PercentDrawDown, StringFormat=F2}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Тестовый Флаг">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Content="Выбрать"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Цвет">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StrategyColor}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <Canvas x:Name="_canvas"
                Grid.Row="13"
                Grid.ColumnSpan="3"
                Margin="10"
                Background="LightGray"
                SizeChanged="_canvas_SizeChanged" />

    </Grid>
</Window>
