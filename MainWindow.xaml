<Window x:Class="Capital.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:local="clr-namespace:Capital"
        mc:Ignorable="d"
        Title="Capital" Height="800" Width="1200">
    <Window.Resources>
        <Style x:Key="TextBlock">
            <Setter Property="TextBlock.Margin" Value="10,0,0,0"/>
            <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TextBox">
            <Setter Property="TextBox.Margin" Value="1,0,1,0"/>
            <Setter Property="TextBox.VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"
                              MinWidth="50"
                              MaxWidth="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*" MinHeight="350"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Депозит" Style="{StaticResource TextBlock}"/>
        <TextBlock Text="Начальный лот" Style="{StaticResource TextBlock}"
                   Grid.Row="1" />
        <TextBlock Text="Тейк" Style="{StaticResource TextBlock}"
                   Grid.Row="2" />
        <TextBlock Text="Стоп" Style="{StaticResource TextBlock}"
                   Grid.Row="3" />
        <TextBlock Text="Комиссия" Style="{StaticResource TextBlock}"
                   Grid.Row="4" />
        <TextBlock Text="% Процент приб." Style="{StaticResource TextBlock}"
                   Grid.Row="5" />
        <TextBlock Text="Кол-во сделок" Style="{StaticResource TextBlock}"
                   Grid.Row="6" />
        <TextBlock Text="Мин. % Депо" Style="{StaticResource TextBlock}"
                   Grid.Row="7" />
        <TextBlock Text="Гарант. обесп." Style="{StaticResource TextBlock}"
                   Grid.Row="9" />
        <ComboBox Name="_comboBox" Margin="5,1" VerticalAlignment="Center"
                  Grid.Row="11" />

        <TextBox x:Name="_depo" Style="{StaticResource TextBox}"
                 Grid.Column="1"/>
        <TextBox x:Name="_startLot" Style="{StaticResource TextBox}"
                 Grid.Column="1" Grid.Row="1"/>
        <TextBox x:Name="_take" Style="{StaticResource TextBox}"
                 Grid.Column="1" Grid.Row="2"/>
        <TextBox x:Name="_stop" Style="{StaticResource TextBox}"
                 Grid.Column="1" Grid.Row="3"/>
        <TextBox x:Name="_comiss" Style="{StaticResource TextBox}"
                 Grid.Column="1" Grid.Row="4"/>
        <TextBox x:Name="_percetnProfit" Style="{StaticResource TextBox}"
                 Grid.Column="1" Grid.Row="5"/>
        <TextBox x:Name="_countTrades" Style="{StaticResource TextBox}"
                 Grid.Column="1" Grid.Row="6"/>
        <TextBox x:Name="_minStartPercent" Style="{StaticResource TextBox}"
                 Grid.Column="1" Grid.Row="7"/>
        <TextBox x:Name="_go" Style="{StaticResource TextBox}"
                 Grid.Column="1" Grid.Row="9"/>
        <Button Content="Рассчитать" Margin="1,0,1,0"
                Click="Button_Click"
                Grid.Column="1" Grid.Row="11"/>
        <GroupBox Header="Таблица результатов" 
                  Grid.RowSpan="12"
                  Margin="10,1"
                  Grid.Column="2">
            <DataGrid x:Name="_dataGrid"
                      Margin="5"
                      AutoGeneratingColumn="DataGrid_AutoGeneratingColumn"/>
        </GroupBox>
        <oxy:PlotView x:Name="plotView"
                      Grid.ColumnSpan="3"
                      Grid.Column="0"
                      Grid.Row="13"
                      Margin="5"/>
    </Grid>
</Window>
