<Window x:Class="Capital.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Capital"
        mc:Ignorable="d"
        Title="Торговые стратегии" Height="800" Width="1200">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*" MinWidth="50" MaxWidth="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Левая панель: заголовки -->
        <TextBlock Text="ДЕПОЗИТ" Margin="6"/>
        <TextBlock Text="НАЧАЛЬНЫЙ ЛОТ" Grid.Row="1" Margin="6"/>
        <TextBlock Text="ТЕЙК" Grid.Row="2" Margin="6"/>
        <TextBlock Text="СТОП" Grid.Row="3" Margin="6"/>
        <TextBlock Text="КОМИССИЯ" Grid.Row="4" Margin="6"/>
        <TextBlock Text="% ПРОЦЕНТ ПРИБ." Grid.Row="5" Margin="6"/>
        <TextBlock Text="КОЛИЧЕСТВО СДЕЛОК" Grid.Row="6" Margin="6"/>
        <TextBlock Text="Мин.% ДЕПОЗИТА" Grid.Row="7" Margin="6"/>
        <TextBlock Text="ГАРАНТИЙНОЕ ОБЕСПЕЧЕНИЕ" Grid.Row="9" Margin="6" FontSize="9"/>

        <ComboBox Name="_comboBox" Grid.Row="11" Margin="5,0"/>

        <!-- Правая панель: поля ввода -->
        <TextBox x:Name="_depo" Grid.Column="1"/>
        <TextBox x:Name="_startLot" Grid.Column="1" Grid.Row="1"/>
        <TextBox x:Name="_take" Grid.Column="1" Grid.Row="2"/>
        <TextBox x:Name="_stop" Grid.Column="1" Grid.Row="3"/>
        <TextBox x:Name="_comiss" Grid.Column="1" Grid.Row="4"/>
        <TextBox x:Name="_percentProfit" Grid.Column="1" Grid.Row="5"/>
        <TextBox x:Name="_countTrades" Grid.Column="1" Grid.Row="6"/>
        <TextBox x:Name="_minStartPercent" Grid.Column="1" Grid.Row="7"/>
        <TextBox x:Name="_go" Grid.Column="1" Grid.Row="9"/>

        <Button Content="Рассчитать" Click="Button_Click" Grid.Column="1" Grid.Row="11"/>

        <!-- Центр: таблица и график -->
        <GroupBox Header="Таблица результатов"
                  Grid.Column="2"
                  Grid.RowSpan="12"
                  Margin="10,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Вручную устанавливаем колонки в датагрид: AutoGenerateColumns="False" и НЕТ <DataGrid.Items> -->
                <DataGrid x:Name="_dataGrid"
                          Margin="5"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True">

                    <DataGrid.Columns>
                        <!-- Стратегия -->
                        <DataGridTextColumn Header="Стратегия" Binding="{Binding StrategyType}" Width="120"/>

                        <!-- Депо -->
                        <DataGridTextColumn Header="Депо" Binding="{Binding Depo}" Width="50"/>

                        <!-- Результат -->
                        <DataGridTextColumn Header="Результат" Binding="{Binding ResultDepo}" Width="120"/>

                        <!-- Прибыль -->
                        <DataGridTextColumn Header="Прибыль" Binding="{Binding Profit}" Width="120"/>

                        <!-- % Прибыль -->
                        <DataGridTextColumn Header="% Прибыль" Binding="{Binding PercentProfit}" Width="90"/>

                        <!-- Макс. просадка -->
                        <DataGridTextColumn Header="Mах просадка" Binding="{Binding MaxDrownDown}" Width="100"/>

                        <!-- Цвет (визуальная метка) -->
                        <DataGridTemplateColumn Header="Цвет" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Rectangle Fill="{Binding ColorBrush}" Width="200" Height="20" Margin="5"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Счётчики сделок -->
                <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="5" HorizontalAlignment="Left">
                    <TextBlock Text="Всего прибыльных сделок:" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBlock x:Name="_totalProfit" Text="0" Margin="0,0,20,0"/>
                    <TextBlock Text="Всего убыточных сделок:" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBlock x:Name="_totalLoss" Text="0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- График -->
        <oxy:PlotView x:Name="_plotView"
                      Grid.Row="13"
                      Grid.ColumnSpan="3"
                      Margin="5"/>

    </Grid>
</Window>